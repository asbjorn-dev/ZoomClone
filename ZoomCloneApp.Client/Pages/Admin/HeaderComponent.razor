@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.FluentUI.AspNetCore.Components

<FluentAppBar Style="height: 100%;" Class="bg-gradient-primary">
    <FluentLabel Typo="Typography.Header"
                 Class="p-2 fw-bold fs-3"
                 Style="font-family: 'Segoe UI', Arial, sans-serif; 
                        color: #0077B6;">
        Zoom Clone
    </FluentLabel>

    <FluentSpacer />

    <FluentAppBarItem Href="/"
                      IconRest="LoginIcon()"
                      IconActive="LoginIcon(active:true)"
                      Text="Login" />

    <FluentAppBarItem Href="/register"
                      IconRest="RegisterIcon()"
                      IconActive="RegisterIcon(active:true)"
                      Text="Register" />
</FluentAppBar>

@code {
    private static Icon LoginIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.PersonAccounts()
            : new Icons.Regular.Size24.PersonAccounts();

    private static Icon RegisterIcon(bool active = false) =>
        active ? new Icons.Filled.Size24.PersonAdd()
            : new Icons.Regular.Size24.PersonAdd();

    // private void HandleOnLoginClick(IAppBarItem item)
    //     => NavigationManager.NavigateTo("/login");

    // private void HandleOnRegisterClick(IAppBarItem item)
    //     => NavigationManager.NavigateTo("/register");


}